# Build Platform Environment Configuration Template
# Copy this file to .env.development for local development

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_URL=postgresql://postgres:dev_password@postgres:5432/build_dev
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=build_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=dev_password

# Redis Configuration
REDIS_URL=redis://:dev_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_password

# MinIO S3 Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=build-dev
MINIO_SECURE=false

# Git Server Configuration (Soft-serve)
GIT_SERVER_HOST=softserve
GIT_SERVER_PORT=23231
GIT_SERVER_HTTP_PORT=23232

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-development-only-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8001

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8001
REACT_APP_ENVIRONMENT=development

# CORS Configuration for Development
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# File Upload Configuration
MAX_UPLOAD_SIZE=100MB
UPLOAD_CHUNK_SIZE=1MB

# VM Management Configuration
VM_MAX_COUNT_PER_USER=5
VM_DEFAULT_CPU=1
VM_DEFAULT_MEMORY=512
VM_DEFAULT_DISK=2048
VM_NETWORK_SUBNET=10.0.100.0/20

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
SESSION_MAX_IDLE_MINUTES=30

# Snapshot Configuration
SNAPSHOT_MAX_COUNT_PER_VM=10
SNAPSHOT_RETENTION_DAYS=30

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Development-specific settings
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_CORS=true
ENABLE_DEBUG_TOOLBAR=true

# External Service URLs (for development)
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Email Configuration (for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@build-platform.dev

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=logs/build-platform.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Feature Flags
ENABLE_RECORDINGS=true
ENABLE_COLLABORATION=true
ENABLE_REAL_TIME_SYNC=true
ENABLE_AI_ASSISTANCE=false