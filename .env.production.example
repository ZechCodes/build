# Production Environment Configuration
# Copy to .env.production and update values for your deployment

# Redis Configuration with TLS
REDIS_URL=rediss://redis-primary:6379
REDIS_PASSWORD=your-super-secure-redis-password-here
REDIS_TLS_CA_CERT=/certs/ca.crt
REDIS_TLS_CLIENT_CERT=/certs/client.crt
REDIS_TLS_CLIENT_KEY=/certs/client.key

# Database Configuration
DATABASE_URL=postgresql://username:password@postgres:5432/buildplatform_prod
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=buildplatform_prod
DATABASE_USER=username
DATABASE_PASSWORD=your-database-password-here

# JWT Configuration
JWT_SECRET=your-256-bit-jwt-secret-key-here-replace-this-with-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# WebSocket Security Configuration
WEBSOCKET_ENFORCE_WSS=true
WEBSOCKET_ALLOWED_ORIGINS=https://app.buildplatform.dev,https://admin.buildplatform.dev
WEBSOCKET_VALIDATE_USER_AGENTS=true

# Network Security Configuration
NETWORK_BIND_INTERNAL=true
SECURITY_MAX_CONNECTIONS_PER_IP=100

# Application Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# SSL/TLS Configuration
SSL_CERT_PATH=/certs/nginx.crt
SSL_KEY_PATH=/certs/nginx.key

# Certificate Management (for Let's Encrypt)
CERTBOT_EMAIL=admin@buildplatform.dev
DOMAINS=buildplatform.dev,app.buildplatform.dev,admin.buildplatform.dev,api.buildplatform.dev

# MinIO S3 Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=buildplatform-prod
MINIO_SECURE=true

# Git Server Configuration
GIT_SERVER_HOST=git-server
GIT_SERVER_PORT=22
GIT_SERVER_HTTP_PORT=3000

# Monitoring Configuration
LOGFIRE_TOKEN=your-logfire-token-here
PROMETHEUS_ENDPOINT=http://prometheus:9090
GRAFANA_ENDPOINT=http://grafana:3000

# Security Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS Settings for Production
ALLOWED_ORIGINS=["https://app.buildplatform.dev", "https://admin.buildplatform.dev"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]
ALLOWED_HEADERS=["Authorization", "Content-Type", "Accept"]

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Performance Settings
MAX_CONCURRENT_SESSIONS=1000
BUFFER_MAX_SIZE_MB=1
SESSION_TIMEOUT_MINUTES=30
RECOVERY_WINDOW_MINUTES=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=buildplatform-backups

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3