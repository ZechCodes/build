+    /// Queue what the DTLS endpoint has to send, for the handlers below to carry out.
+    fn queue_transmits(&mut self) {
+        let Some(dtls_endpoint) = self.dtls_transport.dtls_endpoint.as_mut() else {
+            return;
+        };
+        while let Some(transmit) = dtls_endpoint.poll_transmit() {
+            self.write_outs.push_back(TaggedRTCMessageInternal {
+                now: transmit.now,
+                transport: transmit.transport,
+                message: RTCMessageInternal::Dtls(DTLSMessage::Raw(transmit.message)),
+            });
+        }
+    }
 }
 
