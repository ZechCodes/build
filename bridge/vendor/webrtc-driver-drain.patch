+    /// A relayed connection must not go to sleep holding output it can already send: the loop
+    /// waits in `select!` for sockets, timers and driver events only, so a packet still queued in
+    /// the TURN client when it gets there leaves on the next of those (on an idle connection,
+    /// the ICE agent's tick, up to 200 ms later). These drive the real driver against a TURN
+    /// server played by the test: its socket records what the driver sent, and its answers are
+    /// delivered the way `select!` delivers a datagram. Nothing else runs between steps, so
+    /// "the server has it after one `poll_pass`" means it left in that pass, with no timer and no
+    /// inbound packet to carry it.
+    mod relayed_output {
+        use super::*;
+        use crate::peer_connection::new_test_peer_connection;
+        use crate::runtime::default_runtime;
+        use rtc::peer_connection::RTCPeerConnectionBuilder;
+        use rtc::stun::attributes::{ATTR_NONCE, ATTR_REALM};
+        use rtc::stun::error_code::CODE_UNAUTHORIZED;
+        use rtc::stun::message::{
+            CLASS_ERROR_RESPONSE, CLASS_INDICATION, CLASS_REQUEST, CLASS_SUCCESS_RESPONSE, Getter,
+            METHOD_ALLOCATE, METHOD_CREATE_PERMISSION, METHOD_SEND, Message as StunMessage,
+            MessageType,
+        };
+        use rtc::stun::textattrs::{Nonce, Realm};
+        use rtc::turn::proto::data::Data;
+        use rtc::turn::proto::lifetime::Lifetime;
+        use rtc::turn::proto::peeraddr::PeerAddress;
+        use rtc::turn::proto::relayaddr::RelayedAddress;
+        use std::net::{Ipv4Addr, UdpSocket};
+
+        const RELAY: SocketAddr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1)), 50000);
+        const PEER: SocketAddr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 2)), 40000);
+
+        /// The TURN server's side: a real socket the driver sends to, read without blocking.
+        struct Server {
+            socket: UdpSocket,
+            addr: SocketAddr,
+        }
+
+        impl Server {
+            fn bind() -> Self {
+                let socket = UdpSocket::bind("127.0.0.1:0").unwrap();
+                socket.set_nonblocking(true).unwrap();
+                let addr = socket.local_addr().unwrap();
+                Self { socket, addr }
+            }
+
+            /// Everything the driver has sent so far. Loopback delivery is synchronous, so a
+            /// datagram the driver sent before this call is already here.
+            fn received(&self) -> Vec<StunMessage> {
+                let mut buf = [0u8; 2048];
+                let mut out = Vec::new();
+                while let Ok(n) = self.socket.recv(&mut buf) {
+                    let mut msg = StunMessage::new();
+                    msg.raw = buf[..n].to_vec();
+                    msg.decode()
+                        .expect("the driver sent the TURN server a STUN message");
+                    out.push(msg);
+                }
+                out
+            }
+        }
+
+        fn is(
+            msg: &StunMessage,
+            method: rtc::stun::message::Method,
+            class: rtc::stun::message::MessageClass,
+        ) -> bool {
+            msg.typ == MessageType::new(method, class)
+        }
+
+        fn answer(request: &StunMessage) -> StunMessage {
+            let mut msg = StunMessage::new();
+            let tid = Box::new(request.transaction_id);
+            match request.typ.method {
+                METHOD_ALLOCATE if request.get(ATTR_NONCE).is_err() => msg.build(&[
+                    tid,
+                    Box::new(MessageType::new(METHOD_ALLOCATE, CLASS_ERROR_RESPONSE)),
+                    Box::new(CODE_UNAUTHORIZED),
+                    Box::new(Realm::new(ATTR_REALM, "webrtc.rs".to_owned())),
+                    Box::new(Nonce::new(ATTR_NONCE, "nonce".to_owned())),
+                ]),
+                METHOD_ALLOCATE => msg.build(&[
+                    tid,
+                    Box::new(MessageType::new(METHOD_ALLOCATE, CLASS_SUCCESS_RESPONSE)),
+                    Box::new(RelayedAddress {
+                        ip: RELAY.ip(),
+                        port: RELAY.port(),
+                    }),
+                    Box::new(Lifetime(Duration::from_secs(600))),
+                ]),
+                METHOD_CREATE_PERMISSION => msg.build(&[
+                    tid,
+                    Box::new(MessageType::new(
+                        METHOD_CREATE_PERMISSION,
+                        CLASS_SUCCESS_RESPONSE,
+                    )),
+                ]),
+                other => panic!("the test server does not answer {other}"),
+            }
+            .unwrap();
+            msg
+        }
+
+        /// Hand the driver a datagram from the TURN server, as `select!`'s socket arm does.
+        async fn deliver(
+            driver: &mut PeerConnectionDriver,
+            server: &Server,
+            local: SocketAddr,
+            msg: &StunMessage,
+        ) {
+            driver
+                .deliver_udp_batch(&msg.raw, msg.raw.len(), msg.raw.len(), local, server.addr)
+                .await;
+        }
+
+        /// A driver whose TURN client (on a real local socket) holds an allocation at `RELAY`.
+        async fn allocated_driver(server: &Server) -> (PeerConnectionDriver, SocketAddr) {
+            allocated_driver_with_policy(server, RTCIceTransportPolicy::Relay).await
+        }
+
+        async fn allocated_driver_with_policy(
+            server: &Server,
+            policy: RTCIceTransportPolicy,
+        ) -> (PeerConnectionDriver, SocketAddr) {
+            let runtime = default_runtime().unwrap();
+            let (inner, _rx) = new_test_peer_connection().await;
+            let ice_servers = vec![RTCIceServer {
+                urls: vec![format!("turn:{}?transport=udp", server.addr)],
+                username: "user".to_owned(),
+                credential: "pass".to_owned(),
+            }];
+            let mut driver = PeerConnectionDriver::new(
+                inner,
+                Vec::<SocketAddr>::new(),
+                Vec::new(),
+                MulticastDnsMode::Disabled,
+                ice_servers.clone(),
+                policy,
+                false,
+            );
+            let socket = UdpSocket::bind("127.0.0.1:0").unwrap();
+            let local = socket.local_addr().unwrap();
+            driver
+                .udp_sockets
+                .insert(local, runtime.wrap_udp_socket(socket).unwrap());
+            driver.turn_relayer = RTCTurnRelayer::new(vec![local], ice_servers, policy, runtime);
+            driver.turn_relayer.gather().await.unwrap();
+
+            // Allocate → 401 → authenticated Allocate → success.
+            for _ in 0..2 {
+                driver.poll_pass().await.unwrap();
+                let sent = server.received();
+                let [allocate] = sent.as_slice() else {
+                    panic!("expected one Allocate, got {sent:?}")
+                };
+                assert!(is(allocate, METHOD_ALLOCATE, CLASS_REQUEST));
+                deliver(&mut driver, server, local, &answer(allocate)).await;
+            }
+            driver.poll_pass().await.unwrap();
+            assert!(
+                driver.turn_relayer.contains_local_addr(RELAY),
+                "the allocation took"
+            );
+            assert!(server.received().is_empty());
+            (driver, local)
+        }
+
+        fn sent_to_peer(msgs: &[StunMessage]) -> Vec<Vec<u8>> {
+            msgs.iter()
+                .filter(|msg| is(msg, METHOD_SEND, CLASS_INDICATION))
+                .map(|msg| {
+                    let mut peer = PeerAddress::default();
+                    peer.get_from(msg).unwrap();
+                    assert_eq!(SocketAddr::new(peer.ip, peer.port), PEER);
+                    let mut data = Data::default();
+                    data.get_from(msg).unwrap();
+                    data.0
+                })
+                .collect()
+        }
+
+        fn relayed(message: &[u8]) -> TaggedBytesMut {
+            TaggedBytesMut {
+                now: Instant::now(),
+                transport: TransportContext {
+                    local_addr: RELAY,
+                    peer_addr: PEER,
+                    ecn: None,
+                    transport_protocol: TransportProtocol::UDP,
+                },
+                message: BytesMut::from(message),
+            }
+        }
+
+        /// A packet to a peer the relay has no permission for waits for the grant, and not a
+        /// moment longer: the grant is consumed in the events phase (2.b), after the pass's
+        /// first write phase, and the packet must still leave in that pass.
+        #[test]
+        fn a_packet_held_for_a_permission_leaves_in_the_pass_that_takes_the_grant() {
+            let rt = default_runtime().unwrap();
+            rt.block_on(Box::pin(async move {
+                let server = Server::bind();
+                let (mut driver, local) = allocated_driver(&server).await;
