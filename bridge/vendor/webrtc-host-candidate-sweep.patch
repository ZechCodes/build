+    let mut subnet = SweepSubnet::from_interface(local, &iface, 2, &[]).unwrap();
+    let original = subnet.addresses.to_vec();
+    subnet.cluster_order(&[
+        "10.72.0.254".parse().unwrap(),
+        "10.72.0.254".parse().unwrap(),
+        "10.72.8.1".parse().unwrap(),
+        "8.8.8.8".parse().unwrap(),
