+use super::*;
+use rtc::shared::ifaces::Kind;
+
+fn address(value: &str) -> SocketAddr {
+    value.parse().unwrap()
+}
+fn interface(ip: &str, mask: &str, name: &str) -> Interface {
+    Interface {
+        name: name.into(),
+        kind: Kind::Ipv4,
+        addr: Some(address(ip)),
+        mask: Some(address(mask)),
+        hop: None,
+    }
+}
