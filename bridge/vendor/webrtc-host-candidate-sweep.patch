+        .iter()
+        .position(|ip| *ip == "10.72.0.253".parse::<Ipv4Addr>().unwrap())
+        .unwrap();
+    assert_eq!(
+        subnet.addresses[tie + 1],
+        "10.72.0.255".parse::<Ipv4Addr>().unwrap()
+    );
+}
