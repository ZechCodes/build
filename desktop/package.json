{
  "name": "build-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build desktop client",
  "author": "Build",
  "license": "AGPL-3.0-only",
  "homepage": "https://getbuild.ing",
  "main": "src/main.mjs",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "pack": "node scripts/package-app.mjs --dir",
    "dist": "node scripts/package-app.mjs",
    "dist:linux": "node scripts/package-app.mjs --linux",
    "dist:mac": "node scripts/package-app.mjs --mac",
    "dist:win": "node scripts/package-app.mjs --win"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ing.getbuild.desktop",
    "productName": "Build",
    "protocols": [
      {
        "name": "Build desktop sign-in",
        "schemes": [
          "getbuilding"
        ]
      }
    ],
    "artifactName": "Build-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "maintainer": "Build <hello@getbuild.ing>",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
