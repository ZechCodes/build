    "agent_id",
    "conversation_id",
    "choice_revision",
    "message_start_sequence",
    "posted_sequence"
  ],
  "status_receipt_fields": [
    "operation_id",
    "status",
    "entity_id",
    "agent_id",
    "conversation_id",
    "choice_revision",
    "message_start_sequence",
    "posted_sequence"
  ],
  "statuses": ["queued", "claimed", "delivered", "uncertain"]
}
