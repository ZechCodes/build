---
// The close-ups the film puts on the device screens. Each panel is authored in
// the texture's own pixels (data-panel-region is x y width height in that
// space) and projected onto the screen plane by overlays.js. At rest a panel
// matches the fixture under it — the app's own layout, drawn by
// design/landing-captures — and what differs is added by the action, or
// arrives with the lift (opacity: var(--lift)). In the document version this
// whole block is display: none; the readable proof lives in the acts.
const testLine1 = 'it("keeps archived items in search", () => {';
const testLine2 = 'expect(search("launch notes")).toContain(archived);';
const testClose = "});";
const importLine = 'import { archive, search } from "../search";';
const describeOpen = 'describe("archive", () => {';
const archivedConst = 'const archived = archive("launch notes");';
const branch = "build/archive-search";
const branchLine = `${branch} · ~/code/build/workspaces/archive-search`;
const machineLabel = "zech-mbp · ~/code/build · main";
const humanLine = '    label: "Archived",';
const commitMessage = "archive: keep archived results searchable";
const findingSummary = "Archived results remain visible and now carry a clear label.";
const commits = [
  ["Archive search behavior", "c41e2a9", "Claude Code", "3m ago"],
  ["Review archive coverage", "9b03f17", "Codex", "8m ago"],
  ["Audit edge cases", "5d8a6e0", "Codex", "13m ago"],
  ["Merge #74: persist terminal sessions", "850ab6f", "Build", "1h ago"],
];
// Lucide's pin, external-link and message-square, as the app draws them.
const pinIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/></svg>';
const fileActions = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
const team = [
  ["archive-search", "Implement", "Patching archiveItem so archived entries stay indexed."],
  ["archive-review", "Review", "Reading the search index flow before the patch lands."],
  ["archive-audit", "Audit edge cases", "Checking restore, re-archive and empty-query cases."],
];
---

<div class="overlays" data-overlays aria-hidden="true">
  <!-- Act 1 and 2: the Files view's source pane, with the visitor's test typed
       in, and the file's state in its head once it is. The code is set larger
       than the app's so it reads on the hero. -->
  <div class="panel panel--editor" data-panel="editor" data-panel-device="laptop" data-panel-region="696 150 702 702">
    <div class="file-head"><span class="file-path">src/search/archive.test.ts</span><span class="file-size">122 bytes<span class="status-chip" data-status-chip>2 changes · you</span></span><span class="file-modes"><span class="on">Source</span><span>Edit</span></span></div>
    <div class="ed-code">
      <div><i>1</i><span>{importLine}</span></div>
      <div><i>2</i><span></span></div>
      <div><i>3</i><span>{describeOpen}</span></div>
      <div><i>4</i><span>  {archivedConst}</span></div>
      <div><i>5</i><span></span></div>
      <div data-typed-line><i>6</i><span>  <b data-type={testLine1}></b><em class="caret" data-caret="1"></em></span></div>
      <div data-typed-line><i>7</i><span>    <b data-type={testLine2}></b><em class="caret" data-caret="2"></em></span></div>
      <div data-typed-line><i>8</i><span>  <b data-type={testClose}></b></span></div>
      <div><i>9</i><span>{testClose}</span></div>
    </div>
  </div>

  <!-- Act 3: the issue card, lifted out of the board's Ready column. The hole
       is the column behind the card, a little wider than the card, so nothing
       of it stays behind when it lifts. -->
  <div class="panel panel--hole" data-panel="hole" data-panel-device="laptop" data-panel-region="650 291 252 140"></div>
  <div class="panel panel--issue" data-panel="issue" data-panel-device="laptop" data-panel-region="656 297 240 128" data-panel-flat="0.64 0.46 0.30">
    <div class="issue-card">
      <div class="issue-card-head"><i class="state-dot"></i><span class="issue-number">#78</span><span class="priority">High</span></div>
      <strong>Make archived items searchable</strong>
      <div class="issue-card-labels"><span class="label">search</span><span class="label">bug</span><span class="column-chip" data-column-chip><span data-column="ready">Ready</span><span data-column="progress">In progress</span></span></div>
      <p class="assignee"><span data-assignee="none">Unassigned</span><span data-assignee="agent"><i class="mark"></i>Claude Code</span></p>
      <code class="branch-line" data-branch-line>{branchLine}</code>
    </div>
  </div>

  <!-- Act 4: the fan-out, in the agent rail's chat overview. -->
  <div class="panel panel--team" data-panel="team" data-panel-device="laptop" data-panel-region="988 112 420 784">
    <div class="rail-head"><strong>Agents · <b data-running-count>1</b> working</strong><span class="scope">All workspaces ↗</span><span class="pin" set:html={pinIcon}></span></div>
    <section class="overview-section"><h3>Project agents</h3></section>
    {team.map(([workspace, name, snippet], index) => (
      <section class="overview-section" data-team-row={index + 1}>
        <h3>{workspace}<span class="add">+</span></h3>
        <article class="overview-row">
          <div><strong>{name}</strong><span data-row-status={index === 0 ? "implement" : undefined}>Working</span></div>
          <p>{snippet}</p>
        </article>
      </section>
    ))}
  </div>

  <!-- Act 5: the workflow builder, a project page like Issues, taken over by
       HTML. -->
  <div class="panel panel--builder" data-panel="builder" data-panel-device="laptop" data-panel-region="356 209 1042 522" data-panel-flat="0.5 0.6 0.72">
    <aside class="palette">
      <div class="eyebrow">Add a step</div>
      <div class="palette-item">＋ Agent</div>
      <div class="palette-item" data-palette="test">＋ Test</div>
      <div class="palette-item">＋ Review</div>
      <div class="palette-item">＋ Human gate</div>
      <div class="palette-item">＋ Fan out</div>
    </aside>
    <div class="canvas" data-canvas>
      <div class="canvas-label">Archive search workflow</div>
      <div class="machine-line">{machineLabel}</div>
      <span class="arrow" data-arrow="implement-review">→</span>
      <span class="arrow" data-arrow="implement-test">→</span>
      <span class="arrow" data-arrow="test-review">→</span>
      <span class="arrow" data-arrow="review-gate">→</span>
      <span class="arrow" data-arrow="gate-merge">→</span>
      <article class="node done" data-node="implement"><small>1</small><strong>Implement</strong><span>Claude Code</span><em data-node-status="implement">Done · handoff pending</em></article>
      <article class="node test" data-node="test"><small>2</small><strong>Test</strong><span>archive.test.ts</span><em data-node-status="test">Waiting</em></article>
      <article class="node" data-node="review"><small data-node-index="review">2</small><strong>Review</strong><span>Codex</span><em data-node-status="review">Waiting</em></article>
      <article class="node gate" data-node="gate"><small data-node-index="gate">3</small><strong>You decide</strong><span>Human gate</span><em data-node-status="gate">Waiting</em></article>
      <article class="node" data-node="merge"><small data-node-index="merge">4</small><strong>Merge</strong><span>Build</span><em>Waiting</em></article>
      <p class="canvas-caption" data-canvas-caption>Saved as <em>Fix with tests</em>. Runs on the next issue.</p>
    </div>
  </div>

  <!-- Act 6: the workspace's Changes view: the branch's list on the left,
       the uncommitted diff and the commit box on the right. -->
  <div class="panel panel--git" data-panel="git" data-panel-device="laptop" data-panel-region="396 150 1002 702" data-panel-flat="0.5 0.6 0.6">
    <aside class="git-side">
      <div class="ref-bar"><span class="ref-kind">Branch</span><span class="ref-name">{branch}</span><span class="ref-caret">⌄</span></div>
      <div class="ref-row"><strong>All changes</strong><span>Not pushed yet</span></div>
      <div class="ref-row sel"><strong data-tree-label>Uncommitted</strong><span data-tree-count>+6 −1</span></div>
      <div class="commits-head">Commits</div>
      <div class="commit-row new" data-new-commit><div><strong>{commitMessage}</strong><span><i class="you">you</i> · just now</span></div></div>
      {commits.map(([subject, hash, author, age]) => (
        <div class="commit-row"><div><strong>{subject}</strong><span><code>{hash}</code> · {author} · {age}</span></div></div>
      ))}
    </aside>
    <div class="git-detail">
      <div class="git-toolbar"><span class="stat"><span class="add">+6</span> <span class="del">−1</span></span><span class="git-verb">Fetch</span><span class="git-verb split">↓ Pull<i>▾</i></span><span class="git-verb split">↑ Push<i>▾</i></span><span class="git-verb split">↧ Stash<i>▾</i></span><span class="machine-line">{machineLabel}</span></div>
      <div class="diff-bar"><span>2 files <span class="add">+6</span> <span class="del">−1</span></span><button class="git-button with-lift" data-stage-all type="button" tabindex="-1">Stage all</button><span class="sort">Sort <i>Latest changes</i></span></div>
      <div class="diff-file" data-changed-file><div class="diff-card">
        <div class="diff-title"><i class="select"></i><strong>src/search/archive.ts</strong><span class="author-chip agent" data-chip="agent"><i class="mark"></i>Claude Code</span><span class="badge">EDIT</span><span class="add" data-diff-add>+3</span><span class="del">−1</span><span class="edited">1 minute ago</span><span class="file-actions" set:html={fileActions}></span></div>
        <div class="diff-code" data-hunk="agent">
          <div class="hunk"><i></i><i></i><span>@@ -10,5 +10,7 @@ export function archiveItem(id: string) {"{"}</span></div>
          <div><i>11</i><i>11</i><span>  const item = search.get(id)</span></div>
          <div class="removed"><i>12</i><i></i><span>  search.remove(id)</span></div>
          <div class="added"><i></i><i>12</i><span>  search.update(id, {"{"}</span></div>
          <div class="added"><i></i><i>13</i><span>    archived: true,</span></div>
          <div class="added human" data-human-line><i></i><i>14</i><span><b data-type={humanLine}></b><em class="caret" data-caret="human"></em></span></div>
          <div class="added"><i></i><i data-close-number>14</i><span>  {"})"}</span></div>
        </div>
      </div></div>
      <div class="diff-file" data-changed-file><div class="diff-card">
        <div class="diff-title"><i class="select"></i><strong>src/search/archive.test.ts</strong><span class="author-chip you" data-chip="you">you</span><span class="badge">EDIT</span><span class="add">+3</span><span class="del">−0</span><span class="edited">Just now</span><span class="file-actions" set:html={fileActions}></span></div>
        <div class="diff-code" data-hunk="you">
          <div class="hunk"><i></i><i></i><span>@@ -3,4 +3,7 @@ {describeOpen}</span></div>
          <div><i>4</i><i>4</i><span>  {archivedConst}</span></div>
          <div class="added"><i></i><i>6</i><span>  {testLine1}</span></div>
          <div class="added"><i></i><i>7</i><span>    {testLine2}</span></div>
          <div class="added"><i></i><i>8</i><span>  {testClose}</span></div>
        </div>
      </div></div>
      <div class="clean-tree" data-clean-tree>No uncommitted changes.</div>
      <div class="commit-box">
        <span class="commit-input" data-commit-input><span class="placeholder">Comment on these changes, or write a commit message…</span><b data-type={commitMessage}></b><em class="caret" data-caret="commit"></em></span>
        <button class="git-button primary" data-commit-button type="button" tabindex="-1"><span class="verb-rest">Comment</span><span class="verb-lift">Commit</span></button><span class="git-button primary caret-half">▾</span>
      </div>
    </div>
  </div>

  <!-- Act 7: the review triage on the tablet, a workspace tab beside Changes
       and Files. The region is the tab's whole page, so the opened finding has
       room below the rows. -->
  <div class="panel panel--review" data-panel="review" data-panel-device="tablet" data-panel-region="384 121 724 490" data-panel-flat="0.635 0.63 0.6">
    <div class="review-body">
      <div class="review-head"><div><div class="kicker">Ready for review</div><h1>Review triage</h1></div><div class="review-head-right"><span class="machine-line">{machineLabel}</span><span class="pill" data-review-pill>1 needs you</span></div></div>
      <div class="triage-list">
        <article class="triage-row expanded" data-triage="finding"><div class="triage-inner">
          <header><span class="chevron">⌄</span><div><small>Needs you · 1</small><strong>Search index behaviour changed</strong></div><span class="dot"></span></header>
          <p class="summary">{findingSummary}</p>
          <p class="evidence">archive.test.ts passed · keeps archived items in search ✓</p>
          <div class="finding" data-finding>
            <div class="diff-code">
              <div class="removed"><i>12</i><i></i><span>  search.remove(id)</span></div>
              <div class="added"><i></i><i>12</i><span>  search.update(id, {"{"}</span></div>
              <div class="added"><i></i><i>13</i><span>    archived: true,</span></div>
              <div class="added human"><i></i><i>14</i><span>{humanLine}</span></div>
              <div class="added"><i></i><i>15</i><span>  {"})"}</span></div>
            </div>
            <div class="approval" data-approval>
              <button class="git-button primary" data-approve-button type="button" tabindex="-1">Approve for merge</button>
              <span class="approved" data-approved><i class="you">you</i> Approved for merge.</span>
            </div>
          </div>
        </div></article>
        <article class="triage-row" data-triage="verified"><div class="triage-inner"><header><span class="chevron">›</span><div><small>Verified · 3</small><strong>Checks passed</strong><code>archive.test.ts · search.test.ts · lint</code></div></header></div></article>
        <article class="triage-row" data-triage="failed"><div class="triage-inner"><header><span class="chevron">›</span><div><small>Failed · 0</small><strong>No failing checks</strong></div></header></div></article>
        <article class="triage-row collapsed" data-triage="rest"><div class="triage-inner"><header><span class="chevron">›</span><div><small>Verified · 3 &nbsp;·&nbsp; Failed · 0</small><strong>Everything else passed</strong></div><span class="count">3</span></header></div></article>
      </div>
    </div>
  </div>
</div>
