---
import claudeMark from '../../../../spa/src/assets/harnesses/claude.svg?raw';
import codexMark from '../../../../spa/src/assets/harnesses/codex.svg?raw';
import piMark from '../../../../spa/src/assets/harnesses/pi.svg?raw';
import { HARNESS_NAMES, ROUTINE_EVENTS, SUPPORTED_HARNESSES } from '../../hero/field.js';
const marks = Object.entries({ claude: claudeMark, codex: codexMark, pi: piMark }).map(([name, svg]) => `--mark-${name}:url(data:image/svg+xml,${encodeURIComponent(svg.trim()).replace(/[()']/g, character => `%${character.charCodeAt(0).toString(16).toUpperCase()}`)})`).join(';');
// Match the runtime's pitch and stagger at common viewports. The preview
// replaces this still, decorative first frame when its own bundle arrives.
const notes = Array.from({ length: 24 * 12 }, (_, index) => {
  const row = Math.floor(index / 12);
  const column = index % 12;
  return {
    x: column + .12 + (row % 2) * .48,
    y: row + .12,
    depth: ['quiet', 'normal', 'normal', 'near'][(row * 3 + column) % 4],
    harness: SUPPORTED_HARNESSES[(row + column) % SUPPORTED_HARNESSES.length],
    text: ROUTINE_EVENTS[(row * 7 + column * 13) % ROUTINE_EVENTS.length],
  };
});
---
<div class="hero-field notification-wall" data-hero-field aria-hidden="true" style={marks}>
  <div class="wall-routine" data-wall-routine>
    <div class="wall-first-frame">
      {notes.map((note) => (
        <div class="wall-first-note" data-wall-first-note data-depth={note.depth} data-harness={note.harness} style={`--x:${note.x};--y:${note.y}`}>
          <span class="wall-note__header"><i class="wall-note__mark"></i><span class="wall-note__agent">{HARNESS_NAMES[note.harness]}</span><span class="wall-note__time">now</span></span>
          <span class="wall-note__text">{note.text}</span>
        </div>
      ))}
    </div>
  </div>
</div>
