# Build app image (ghcr.io/8ly-dev/build-app). Build context: the REPO ROOT
# (the SPA lives at spa/, beside skriftapp/):
#
#   podman build -t build-app -f skriftapp/Containerfile .
#
# The Build checkout pins the transport source; UPSTREAM.md records its origin.
# Install the local package first, then the SPA from the committed locks.

# --- spa: Vite bundle (multi-stage node builder) ---------------------------
FROM docker.io/library/node:22.23.4-bookworm-slim AS spa
WORKDIR /build/repo
# Match the consumer lock toolchain. No dependency lifecycle scripts run.
RUN npm install -g npm@12.0.2 --ignore-scripts --no-audit --no-fund
COPY transport/js/package.json transport/js/package-lock.json ./transport/js/
COPY transport/js/src/ ./transport/js/src/
COPY transport/js/LICENSE.md transport/js/README.md ./transport/js/
RUN cd transport/js && npm ci --ignore-scripts --no-audit --no-fund
COPY spa/package.json spa/package-lock.json spa/.npmrc ./spa/
RUN cd spa && npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund
COPY spa/ ./spa/
# Preserve relay/version inputs and Vite's output beside the source tree.
ARG VITE_RELAY_URL=wss://relay.getbuild.ing
ARG VITE_BUILD_VERSION=dev
RUN cd spa \
 && VITE_RELAY_URL="$VITE_RELAY_URL" VITE_BUILD_VERSION="$VITE_BUILD_VERSION" npm run build
# → emits /build/repo/skriftapp/buildapp/static/ (vite outDir).

# --- landing: Astro static build (multi-stage node builder) ----------------
# The public homepage is a static Astro document, built the same way the SPA is:
# in-image, from the repo's own source, no CDN. Stock npm resolves this manifest
# (the spa stage's npm@12 pin is for the SPA's peer graph, not a house rule).
FROM docker.io/library/node:22.23.4-bookworm-slim AS landing
WORKDIR /build/repo/landing
# Manifests first, so the dependency layer survives a copy edit.
COPY landing/package.json landing/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY landing/ ./
# The hero's notification field draws the harness marks from the SPA's own
# files (HeroField.astro imports them ?raw), one source for both. Every
# import outside landing/ needs its COPY here; landing/test/image-context.test.mjs
# fails when one is missing.
COPY spa/src/assets/harnesses/ /build/repo/spa/src/assets/harnesses/
RUN npm run build
# → emits /build/repo/skriftapp/buildapp/landing/generated/ (astro outDir).
# landing/node_modules is excluded from the build context (.containerignore),
# so the COPY above never drags the host's install in over npm ci's.

# --- runtime: Python 3.13 on Bookworm -------------------------------------
# Match CI's pinned uv for lockfile and pyproject's [tool.uv] settings.
FROM docker.io/library/python:3.13-slim-bookworm AS app
# Keep Bookworm: uv 0.13.4 has no Python 3.13 Bookworm image.
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /uvx /bin/
# The base ships pip with its own CA bundle; update it for the CA key incident.
RUN uv pip install --system --no-cache 'pip==26.2.2'
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Dependencies first for layer caching. vendor/ carries the interim skrift
# wheel referenced by [tool.uv.sources] until 0.2.0a10 is on PyPI.
COPY skriftapp/pyproject.toml skriftapp/uv.lock ./
COPY skriftapp/vendor ./vendor
RUN uv sync --frozen --no-dev

# The bundled transport retains its scoped upstream license notice.
COPY transport/LICENSE.md ./licenses/secure-transport-LICENSE.md

# App code + the spa stage's bundle.
COPY skriftapp/app.yaml skriftapp/entrypoint.sh ./
COPY skriftapp/buildapp ./buildapp
COPY skriftapp/migrations ./migrations
# The app's own admin templates: Skrift's engine also reads ./templates/.
COPY skriftapp/templates ./templates
# Public installers served from the same scripts used in source checkouts.
COPY scripts/install.sh /scripts/install.sh
COPY scripts/install-desktop.sh /scripts/install-desktop.sh
COPY --from=spa /build/repo/skriftapp/buildapp/static ./buildapp/static
# The generated homepage, after buildapp/ so it lands inside the landing
# directory the asset route already serves.
COPY --from=landing /build/repo/skriftapp/buildapp/landing/generated ./buildapp/landing/generated
RUN chmod +x /app/entrypoint.sh \
 && useradd --create-home --uid 10001 appuser \
 && chown -R appuser:appuser /app
USER appuser

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    SKRIFT_ENV=production
EXPOSE 8080
CMD ["/app/entrypoint.sh"]
