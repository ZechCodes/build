# Repo-root context: transport and web retain their checkout-relative layout.
# Build only; QA pairing is an explicit compose command outside image creation.
FROM docker.io/library/node:22.23.3-bookworm-slim
WORKDIR /app
RUN npm install -g npm@12.0.2 --ignore-scripts --no-audit --no-fund
COPY transport/js/package.json transport/js/package-lock.json ./transport/js/
COPY transport/js/src/ ./transport/js/src/
COPY transport/js/LICENSE.md transport/js/README.md ./transport/js/
RUN cd transport/js && npm ci --ignore-scripts --no-audit --no-fund
COPY web/package.json web/package-lock.json web/.npmrc ./web/
WORKDIR /app/web
# Playwright is only needed for browser demos; QA uses the production deps.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY web/*.mjs web/*.html ./
EXPOSE 8080
CMD ["node", "serve.mjs"]
