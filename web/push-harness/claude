#!/bin/sh
# A stand-in `claude` for the browser push check (web/push-check.mjs, #191).
#
# It looks like an interactive harness to the bridge (it turns on bracketed
# paste, which is the readiness signal a spawn waits for), and once its prompt
# is pasted it acts as its agent through Build's real MCP entry, with the
# session token the bridge handed it: a comment on the issue named in
# /tmp/push-issue (when there is one), then a Complete report to the user.
# Both are what a real agent does, so both reach the bridge's push triggers.
#
# Mounted at /usr/local/bin/claude by deploy/compose.push-check.yml.
printf '\033[?2004h'
AGENT=""
while [ $# -gt 0 ]; do
  if [ "$1" = "--mcp-config" ]; then
    AGENT=$(basename "$2" .json | sed 's/^mcp-//')
    shift
  fi
  shift
done
# The pasted prompt is the go signal.
dd bs=1 count=1 >/dev/null 2>&1
sleep 1
ISSUE=$(cat /tmp/push-issue 2>/dev/null || true)
{
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"push-check","version":"1"}}}'
  printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
  if [ -n "$ISSUE" ]; then
    printf '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"comment_issue","arguments":{"issue_id":"%s","body":"A question for you."}}}\n' "$ISSUE"
  fi
  printf '%s\n' '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"post_thread_message","arguments":{"status":"Complete","body":"Hello from the push check."}}}'
  sleep 4
} | build-bridge mcp --task "$AGENT" >> /tmp/push-harness.log 2>&1
cat >/dev/null
